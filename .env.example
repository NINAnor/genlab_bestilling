POSTGRES_PASSWORD=postgres
DJANGO_SECRET_KEY=secret
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres?sslmode=disable

# Generate a client id/client secret on keycloack
OIDC_CLIENT_ID=
OIDC_SECRET=
OIDC_PROVIDER_URL=https://keycloak.nina.no/realms/nina/

# RSA private key (PEM) used to sign OIDC ID tokens issued by this app's /o/ endpoint.
# Auto-generated and exported by aliases.sh (see oidc.key).
OIDC_RSA_PRIVATE_KEY=
